@using XaliseConnect.Portal.Models.IntegrationRequest
@model IntegrationRequestSearchCriteriaViewModel

<form asp-route="@IntegrationRequestRoute.CSTS_SEARCH"
      id="xal-id-integration-request-search"
      method="get"
      class="card mb-3 xal-form-search"
      data-xal-search-results="#xal-id-integration-request-results"
      data-xal-search-loader="overlay"
      data-xal-search-loader-message="Recherche en cours..."
      data-xal-search-loader-min-duration="5000"
      role="search"
      aria-label="Recherche des demandes d'intégration">
    <input type="hidden" name="page" value="1">
    <input type="hidden" name="pageSize" value="10">
    <input type="hidden" name="sort" value="@IntegrationRequestSortColumn.CSTS_RECEIVED_AT">
    <input type="hidden" name="direction" value="@PaginationSortDirection.CSTS_DESCENDING">
    <div class="card-body">
        <div class="row gy-2 gx-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-3">
                <label for="search-request-id" class="form-label">N° de demande</label>
                <input name="requestNumber"
                       id="search-request-id"
                       type="search"
                       class="form-control form-control-sm"
                       autocomplete="off"
                       placeholder="Ex : INT-20261021">
            </div>

            <div class="col-12 col-md-6 col-xl-6">
                <div class="row gy-2 gx-3">
                    <div class="col-12 col-sm-6">
                        <label for="search-date-start" class="form-label">Reçue à partir du</label>
                        <input name="receivedFromUtc" id="search-date-start" type="datetime-local" class="form-control form-control-sm" data-xal-search-convert="datetime-local-to-utc">
                    </div>
                    <div class="col-12 col-sm-6">
                        <label for="search-date-end" class="form-label">Reçue jusqu'au</label>
                        <input name="receivedToUtc" id="search-date-end" type="datetime-local" class="form-control form-control-sm" data-xal-search-convert="datetime-local-to-utc">
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <label for="search-source" class="form-label">Source</label>
                <select name="sourceId" id="search-source" class="form-select form-select-sm">
                    <option value="">Toutes les sources</option>
                    <option value="1">Dépôt interne</option>
                    <option value="2">Transmission interne</option>
                    <option value="3">Transmission externe</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <label for="search-correlation-value" class="form-label">Valeur de corrélation</label>
                <input name="correlationValue" id="search-correlation-value" type="search" class="form-control form-control-sm" placeholder="Identifiant...">
            </div>

            <div class="col-12 col-xl-6">
                <div class="row gy-2 gx-3">
                    <div class="col-12 col-sm-4">
                        <label for="search-status-reception" class="form-label">Statut de réception</label>
                        <select name="statusReception"
                                id="search-status-reception"
                                class="form-select form-select-sm"
                                asp-items="Model.StatusReceptionOptions">
                        </select>
                    </div>
                    <div class="col-12 col-sm-4">
                        <label for="search-status-transport" class="form-label">Statut de transport</label>
                        <select name="statusTransport"
                                id="search-status-transport"
                                class="form-select form-select-sm"
                                asp-items="Model.StatusTransportOptions">
                        </select>
                    </div>
                    <div class="col-12 col-sm-4">
                        <label for="search-status-integration" class="form-label">Statut d'intégration</label>
                        <select name="statusIntegration"
                                id="search-status-integration"
                                class="form-select form-select-sm"
                                asp-items="Model.StatusIntegrationOptions">
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-3 d-flex justify-content-end gap-2 mt-3 mt-xl-0">
                <button type="submit" class="btn btn-sm btn-xalise">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>
                    Rechercher
                </button>
                <button type="button" class="btn btn-sm btn-secondary" data-xal-form-clear-criteria>
                    <i class="bi bi-eraser me-1" aria-hidden="true"></i>
                    Vider les filtres
                </button>
            </div>
        </div>
    </div>
</form>
