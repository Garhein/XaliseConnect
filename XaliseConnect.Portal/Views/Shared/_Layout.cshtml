<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href="~/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <title>Xalise Connect > @ViewData["Title"]</title>
    </head>
    <body data-bs-theme="xalise">
        <div id="xal-id-portals">
            <!-- Overlay appliqué sur la page lors de certaines actions -->
            <div id="xal-id-loader-overlay"
                 class="xal-loader-overlay"
                 aria-hidden="true"
                 hidden>
                <div class="xal-loader-overlay__content">
                    <div class="xal-loader-overlay__spinner" aria-hidden="true"></div>
                    <span class="xal-loader-overlay__message"></span>
                </div>
            </div>

            <!-- Template du loader -->
            <template id="xal-id-loader-placeholder-template">
                <div class="xal-loader-placeholder">
                    <div class="xal-loader-placeholder__block"></div>
                    <div class="xal-loader-placeholder__block"></div>
                    <div class="xal-loader-placeholder__block"></div>
                    <div class="xal-loader-placeholder__block"></div>
                    <div class="xal-loader-placeholder__block"></div>
                    <div class="xal-loader-placeholder__block"></div>
                    <div class="xal-loader-placeholder__block"></div>
                </div>
            </template>

            <!-- Conteneur des toast -->
            <div class="toast-container position-fixed bottom-0 end-0 p-3">
                <!-- Template des toast de feedback -->
                <template id="xal-id-toast-template-feedback">
                    <div class="toast xal-toast" role="status" aria-live="polite" aria-atomic="true">
                        <div class="toast-header">
                            <i class="bi me-2 xal-toast__icon" aria-hidden="true" hidden></i>
                            <strong class="me-auto xal-toast__label"></strong>
                            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Fermer"></button>
                        </div>
                        <div class="toast-body xal-toast__message"></div>
                    </div>
                </template>
            </div>

            <!-- Template de modale -->
            <template id="xal-id-modal-template">
                <div class="modal fade xal-modal" tabindex="-1" aria-modal="true" role="dialog">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header xal-modal__header">
                                <h6 class="modal-title xal-modal__title"></h6>
                                <button type="button" class="btn-close xal-modal__close-button" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body xal-modal__body"></div>
                            <div class="modal-footer xal-modal__footer"></div>
                        </div>
                    </div>
                </div>
            </template>

            <!-- Template de bouton pour les modales -->
            <template id="xal-id-modal-button-template">
                <button type="button" class="btn xal-modal__button"></button>
            </template>

            <!-- Template d'icône pour les boutons des modales -->
            <template id="xal-id-modal-icon-template">
                <i class="bi me-2 xal-modal__icon" aria-hidden="true"></i>
            </template>
        </div>

        <!-- Barre de navigation -->
        <nav role="navigation"
             id="xal-id-main-navbar"
             class="navbar navbar-expand fixed-top flex-md-nowrap p-0 xal-main-navbar xal-u-gradient"
             aria-label="Navigation principale">
            <div class="container-fluid justify-content-start p-0">
                <!-- Barre de progression -->
                <div id="xal-id-loader-nav"
                     class="xal-loader-nav"
                     role="progressbar"
                     aria-label="Chargement en cours"
                     aria-hidden="true"
                     hidden>
                    <div class="xal-loader-nav__track"></div>
                </div>

                <!-- Bouton d'ouverture/fermeture du menu latéral -->
                <div class="navbar-nav flex-row align-items-center d-lg-none">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#xal-id-main-sidebar"
                            aria-controls="xal-id-main-sidebar"
                            aria-label="Ouvrir le menu principal">
                        <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
                    </button>
                </div>

                <!-- .navbar-brand -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="navbar-brand d-inline-flex align-items-center me-0 py-2 px-3 fs-6 text-white">
                    <span class="xal-main-navbar__brand me-2">
                        <img src="~/favicon.svg" alt="" aria-hidden="true" />
                    </span>
                    <span>Xalise Connect</span>
                </a>

                <!-- .navbar-nav -->
                <div class="navbar-nav flex-row ms-auto me-3">
                    <div class="dropdown">
                        <button type="button"
                                class="btn btn-outline-secondary d-flex"
                                title="Accèder aux raccourcis"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-controls="xal-id-shortcuts-menu"
                                aria-label="Accèder aux raccourcis">
                            <i class="bi bi-grid-3x3-gap me-2" aria-hidden="true"></i>
                            <i class="bi bi-chevron-down m-0" aria-hidden="true"></i>
                        </button>
                        <ul id="xal-id-shortcuts-menu" class="dropdown-menu dropdown-menu-end mt-2">
                            <li>
                                <a asp-controller="IntegrationRequest" asp-action="Index"  class="dropdown-item">
                                    <i class="bi bi-display me-1" aria-hidden="true"></i>
                                    Demandes d'intégration
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a href="#" class="dropdown-item">
                                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                                    Planning
                                </a>
                            </li>
                            <li>
                                <a href="#" class="dropdown-item">
                                    <i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>
                                    Statistiques
                                </a>
                            </li>
                        </ul>
                    </div>
                    <button type="button"
                            class="btn btn-outline-secondary position-relative flex-shrink-0 text-nowrap"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#xal-id-notification-center"
                            aria-controls="xal-id-notification-center"
                            aria-label="99+ notifications non lues"
                            data-xal-tooltip="99+ notifications non lues">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        <span class="badge bg-danger rounded-pill d-none d-md-inline-block xal-notification-indicator">
                            <span class="xal-notification-indicator__badge">99+</span>
                            <span class="visually-hidden">notifications non lues</span>
                        </span>
                        <span class="ms-1 d-md-none bg-danger xal-notification-indicator__dot xal-u-dot-1-70" aria-hidden="true"></span>
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary flex-shrink-0 text-nowrap"
                            aria-label="99+ messages non lus"
                            data-xal-tooltip="99+ messages non lus">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <span class="badge bg-danger rounded-pill d-none d-md-inline-block">
                            99+
                            <span class="visually-hidden">messages non lus</span>
                        </span>
                        <span class="xal-u-dot-1-70 ms-1 d-md-none bg-danger" aria-hidden="true"></span>
                    </button>
                    <div class="dropdown">
                        <button type="button"
                                class="btn btn-outline-secondary d-flex flex-shrink-0 text-nowrap"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-controls="xal-id-user-menu"
                                aria-label="Menu du compte Laura Bellerose">
                            <img src="~/img/user.jpg" alt="" class="rounded-circle me-2" width="24" height="24" />
                            <span class="d-none d-md-inline">Laura Bellerose</span>
                            <i class="bi bi-chevron-down m-0 ms-md-2" aria-hidden="true"></i>
                        </button>
                        <ul id="xal-id-user-menu" class="dropdown-menu dropdown-menu-end mt-2">
                            <li class="dropdown-header">
                                <div class="fw-semibold">Laura Bellerose</div>
                                <div class="fst-italic small fw-semibold text-body-secondary">Directrice Générale</div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a href="#" class="dropdown-item">
                                    <i class="bi bi-person-fill me-1" aria-hidden="true"></i>
                                    Profil
                                </a>
                            </li>
                            <li>
                                <a href="#" class="dropdown-item active" aria-current="true">
                                    <i class="bi bi-gear-fill me-1" aria-hidden="true"></i>
                                    Paramètres
                                </a>
                            </li>
                            <li>
                                <a href="#" class="dropdown-item disabled" aria-disabled="true" tabindex="-1">
                                    <i class="bi bi-envelope-fill me-1" aria-hidden="true"></i>
                                    Menu désactivé
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a href="../auth/login.html" class="dropdown-item">
                                    <i class="bi bi-door-closed-fill me-1" aria-hidden="true"></i>
                                    Se déconnecter
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div id="xal-id-application-layout"
             class="xal-application-layout"
             aria-describedby="xal-id-dashboard-title">
            <!-- Entête de page : fil d'Ariane, titre -->
            <header class="bg-white border-bottom shadow-sm px-3 px-lg-4 py-2">
                <div class="container-fluid p-0">
                    <div class="d-flex flex-column flex-md-row align-items-md-start gap-2 gap-md-4">
                        <nav class="flex-shrink-0" aria-label="Fil d’Ariane">
                            <ol class="xal-breadcrumb breadcrumb mb-1 mb-md-0 mt-md-1">
                                <li class="breadcrumb-item">
                                    <a asp-controller="Home" asp-action="Index" aria-label="Accueil">
                                        <i class="bi bi-house-door" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li class="breadcrumb-item">Supervision</li>
                                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                        <div class="flex-grow-1 mb-2 mb-md-0 xal-page-header__title">
                            <h1 id="xal-id-dashboard-title" class="h5 mb-0">@ViewData["Title"]</h1>
                            @if (ViewData["Subtitle"] is string subtitle)
                            {
                                <p class="small text-body-secondary mb-0 xal-page-header__subtitle">@subtitle</p>
                            }
                        </div>
                    </div>
                </div>
            </header>

            <div class="d-lg-flex flex-grow-1">
                <!-- Barre latérale -->
                <aside id="xal-id-main-sidebar"
                       class="offcanvas-lg offcanvas-start xal-main-sidebar border-end bg-white"
                       tabindex="-1"
                       aria-label="Menu principal">
                    <div class="offcanvas-header d-lg-none py-2">
                        <h2 class="offcanvas-title h5">Menu principal</h2>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="offcanvas"
                                data-bs-target="#xal-id-main-sidebar"
                                aria-label="Fermer le menu principal">
                        </button>
                    </div>
                    <div class="offcanvas-body py-3 px-2">
                        <nav aria-label="Navigation principale">
                            <ul id="xal-id-main-sidebar-navigation" class="nav nav-pills flex-column p-0">
                                <li class="nav-item">
                                    <a asp-controller="Home" asp-action="Index" class="nav-link">
                                        <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>
                                        Tableau de bord
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <button type="button"
                                            class="nav-link active xal-main-sidebar__group-toggle"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#xal-id-main-sidebar-menu-supervision"
                                            aria-expanded="true"
                                            aria-controls="xal-id-main-sidebar-menu-supervision"
                                            aria-current="page">
                                        <i class="bi bi-display me-2" aria-hidden="true"></i>
                                        <span>Supervision</span>
                                        <i class="bi bi-chevron-down xal-main-sidebar__caret" aria-hidden="true"></i>
                                    </button>
                                    <div id="xal-id-main-sidebar-menu-supervision"
                                         class="collapse show"
                                         data-bs-parent="#xal-id-main-sidebar-navigation">
                                        <ul class="nav flex-column p-0 xal-main-sidebar__submenu">
                                            <li class="nav-item">
                                                <a asp-controller="IntegrationRequest" asp-action="Index" class="nav-link active" aria-current="page">
                                                    Demandes d'intégration
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        </nav>
                    </div>

                    <!-- Informations sur la version et l'environnement -->
                    <footer class="xal-main-sidebar__footer border-top p-2">
                        <div class="d-flex align-items-center justify-content-center gap-2">
                            <span class="small text-body-secondary">Version 1.0.1</span>
                            <span class="badge text-bg-success">Production</span>
                            <!--<span class="badge text-bg-warning">Recette</span>-->
                            <!--<span class="badge text-bg-secondary">Développement</span>-->
                            <!--<span class="badge text-bg-dark">Local</span>-->
                        </div>
                    </footer>
                </aside>

                <!-- Contenu de la page -->
                <main id="xal-main-content" class="xal-main-content container-fluid flex-grow-1 p-3 p-lg-4">
                    @RenderBody()
                </main>
            </div>
        </div>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script type="module" src="~/js/xalise-pages.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
